Killer:AddSwitch("Auto Kill 👹", function(bool)
    autoKill = bool

    task.spawn(function()
        local currentTarget, targetStartTime = nil, 0

        while autoKill do
            local character = LocalPlayer.Character
            local rootPartSelf = character and character:FindFirstChild("HumanoidRootPart")
            local rightHand = character and character:FindFirstChild("RightHand")
            local leftHand = character and character:FindFirstChild("LeftHand")

            -- Equipar y activar puño
            local punch = (LocalPlayer.Backpack:FindFirstChild("Punch") or (character and character:FindFirstChild("Punch")))
            if punch and character then
                if punch.Parent ~= character then punch.Parent = character end
                if punch:FindFirstChild("attackTime") then punch.attackTime.Value = 0 end
                punch:Activate()
            end

            if character and rootPartSelf and rightHand and leftHand then
                -- Validar si el objetivo actual sigue vivo y está dentro del límite de 2 segundos
                local tChar = currentTarget and currentTarget.Character
                local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

                local isTargetValid = currentTarget 
                    and currentTarget.Parent 
                    and not playerWhitelist[currentTarget.Name] 
                    and tRoot and tHum and tHum.Health > 0

                -- Si el objetivo no es válido o pasaron 2 segundos, seleccionar un nuevo jugador
                if not isTargetValid or (tick() - targetStartTime >= 2) then
                    currentTarget = nil
                    for _, target in ipairs(Players:GetPlayers()) do
                        if target ~= LocalPlayer and not playerWhitelist[target.Name] then
                            local c = target.Character
                            local r = c and c:FindFirstChild("HumanoidRootPart")
                            local h = c and c:FindFirstChildOfClass("Humanoid")

                            if r and h and h.Health > 0 then
                                currentTarget = target
                                targetStartTime = tick()
                                tRoot = r
                                break
                            end
                        end
                    end
                end

                -- Teletransporte y toque de daño
                if currentTarget and tRoot then
                    pcall(function()
                        rootPartSelf.CFrame = tRoot.CFrame * CFrame.new(0, 0, 2)

                        firetouchinterest(rightHand, tRoot, 1)
                        firetouchinterest(leftHand, tRoot, 1)
                        firetouchinterest(rightHand, tRoot, 0)
                        firetouchinterest(leftHand, tRoot, 0)
                    end)
                end
            end

            task.wait(0.01)
        end

        -- Desequipar puño al desactivar
        local punch = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Punch")
        if punch then
            punch.Parent = LocalPlayer.Backpack
        end
    end)
end)


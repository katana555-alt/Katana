local function getBossHP(model)
	if not model then return 0, 0 end

	local stats = model:FindFirstChild("stats")
	if stats then
		local h = stats:FindFirstChild("Health")
		local m = stats:FindFirstChild("MaxHealth")
		if h and m then return h.Value or 0, m.Value or 0 end
	end

	local h2 = model:FindFirstChild("Health")
	local m2 = model:FindFirstChild("MaxHealth")
	if h2 and m2 and h2:IsA("ValueBase") and m2:IsA("ValueBase") then
		return h2.Value or 0, m2.Value or 0
	end

	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then return hum.Health or 0, hum.MaxHealth or 0 end

	local ah = tonumber(model:GetAttribute("Health"))
	local am = tonumber(model:GetAttribute("MaxHealth"))
	if ah or am then return ah or 0, am or 0 end

	local wh = tonumber(workspace:GetAttribute("BossHealth"))
	local wm = tonumber(workspace:GetAttribute("BossMaxHealth"))
	if wh or wm then return wh or 0, wm or 0 end

	local nh = tonumber(workspace:GetAttribute("BossHealth_" .. model.Name))
	local nm = tonumber(workspace:GetAttribute("BossMaxHealth_" .. model.Name))
	if nh or nm then return nh or 0, nm or 0 end

	return 0, 0
end


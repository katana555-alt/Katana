Boss.findActiveBoss = function()
	local model
	for _, candidate in ipairs(CollectionService:GetTagged("BossEventBoss")) do
		if candidate:IsA("Model") and candidate:IsDescendantOf(workspace) then
			model = candidate
			break
		end
	end
	if not model then
		local events = workspace:FindFirstChild("Events")
		local bossFolder = events and (events:FindFirstChild("BossEvent") or events:FindFirstChild("BossArena"))
		if bossFolder then
			for _, candidate in ipairs(bossFolder:GetDescendants()) do
				if candidate:IsA("Model") and (candidate:FindFirstChild("BossDamageHitbox") or candidate:HasTag("BossEventBoss")) then
					model = candidate
					break
				end
			end
		end
	end
	if not model then return end
	local hitbox = model:FindFirstChild("BossDamageHitbox", true)
	if not hitbox or not hitbox:IsA("BasePart") then return end
	local hp, mx = getBossHP(model)
	if hp <= 0 then return end
	return model, hp, mx, hitbox
end

Boss.formatCountdown = function(seconds)
	seconds = math.max(0, math.floor(seconds or 0))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	return string.format("%dh %dmin %ds", h, m, s)
end

local function collectChest(generation)
	local startedAt = os.clock()
	local chest, prompt, part
	repeat
		for _, candidate in ipairs(CollectionService:GetTagged("BossEventChest")) do
			if candidate:IsDescendantOf(workspace) then chest = candidate break end
		end
		if not chest then chest = workspace:FindFirstChild("BossChest", true) end
		if not chest then
			for _, c in ipairs(workspace:GetDescendants()) do
				if c:IsA("ProximityPrompt") and c.Name == "bossChestPrompt" then chest = c.Parent break end
			end
		end
		if chest and chest:GetAttribute("BossChestEmerging") ~= true then break end
		task.wait(0.1)
	until not Boss.Data.Running or Boss.Data.Generation ~= generation or os.clock() - startedAt >= 12
	if not Boss.Data.Running or Boss.Data.Generation ~= generation or not chest then return end

	prompt = chest:FindFirstChild("bossChestPrompt", true)
	part = prompt and prompt.Parent or (chest:IsA("Model") and (chest.PrimaryPart or chest:FindFirstChildWhichIsA("BasePart", true))) or chest
	if not part or not part:IsA("BasePart") then return end

	startedAt = os.clock()
	repeat
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root and chest.Parent and part.Parent then
			pcall(function()
				root.CFrame = CFrame.lookAt(part.Position + Vector3.new(0, 3, 4), part.Position)
				root.AssemblyLinearVelocity = Vector3.zero
			end)
			task.wait(0.15)
			if not (prompt and prompt.Parent and type(fireproximityprompt) == "function" and pcall(fireproximityprompt, prompt)) then
				pcall(function()
					VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
					task.wait(0.1)
					VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
				end)
			end
		end
		task.wait(0.25)
	until not Boss.Data.Running or Boss.Data.Generation ~= generation or not chest.Parent or os.clock() - startedAt >= 12
end


local function hasTrainingStats()
	local ls = LocalPlayer:FindFirstChild("leaderstats")
	local strength = ls and ls:FindFirstChild("Strength")
	local durability = LocalPlayer:FindFirstChild("Durability")
	return strength and durability and strength.Value > 0 and durability.Value > 0
end

local function prepareForBoss(bossData)
	if not bossData.Preparation then
		pauseTraining()
		bossData.Preparation = {LastRep = 0}
		bossData.Phase = "Training"
	end
	local prep = bossData.Preparation
	local char = LocalPlayer.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if prep.Character ~= char or prep.Rebirths ~= getRebirthsValue() then
		prep.Character = char
		prep.Rebirths = getRebirthsValue()
		prep.StartedAt = nil
		prep.LastRep = 0
		prep.Required = not hasTrainingStats()
	end
	if not humanoid or humanoid.Health <= 0 then
		prep.StartedAt = nil
		return false
	end
	if not prep.Required then
		bossData.FightCharacter = char
		bossData.FightRebirths = getRebirthsValue()
		bossData.Preparation = nil
		return true
	end
	if LocalPlayer.Character ~= char or humanoid.Health <= 0 then return false end
	local backpack = getBackpack()
	local ls = LocalPlayer:FindFirstChild("leaderstats")
	local strength = ls and ls:FindFirstChild("Strength")
	if not strength then return false end
	local toolName = strength.Value < 2000 and "Weight" or "Pushups"
	if toolName == "Weight" then prep.StartedAt = nil end
	local tool = char:FindFirstChild(toolName) or (backpack and backpack:FindFirstChild(toolName))
	if not tool then
		prep.StartedAt = nil
		return false
	end
	if tool.Parent ~= char then humanoid:EquipTool(tool) end
	if tool.Parent ~= char then prep.StartedAt = nil return false end
	if toolName == "Pushups" then prep.StartedAt = prep.StartedAt or os.clock() end
	if os.clock() - prep.LastRep >= 0.1 then
		local me = getMuscleEvent()
		if me then me:FireServer("rep") end
		prep.LastRep = os.clock()
	end
	if toolName == "Weight" then return false end
	if os.clock() - prep.StartedAt < Boss.Data.PreparationSeconds then return false end
	bossData.FightCharacter = char
	bossData.FightRebirths = getRebirthsValue()
	bossData.Preparation = nil
	return true
end

local function needsRetraining(bossData)
	local char = LocalPlayer.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	return not humanoid or humanoid.Health <= 0
		or bossData.FightCharacter ~= LocalPlayer.Character
		or bossData.FightRebirths ~= getRebirthsValue()
end

local function getBossHeadPosition(model, hitbox)
	local head = model:FindFirstChild("Head", true) or model:FindFirstChild("head", true)
	if head and head:IsA("BasePart") then return head.Position end
	if head and head:IsA("Bone") then return head.WorldPosition end
	return hitbox.Position + Vector3.new(0, hitbox.Size.Y * 0.35, 0)
end

local function evadeAttack(bossData, model, hitbox, root, humanoid)
	local sequence = model:GetAttribute("BossAttackSequence")
	local attackKind = model:GetAttribute("BossAttackKind")
	local attackCFrame = model:GetAttribute("BossAttackCFrame")
	local impactTime = model:GetAttribute("BossAttackImpactTime")

	if typeof(sequence) == "number" and sequence ~= bossData.AttackSequence then
		bossData.AttackSequence = sequence
		if typeof(attackKind) == "string" and typeof(attackCFrame) == "CFrame" and typeof(impactTime) == "number" then
			bossData.EvadeUntil = impactTime + 0.6
		end
	end

	if typeof(attackCFrame) ~= "CFrame" or workspace:GetServerTimeNow() > bossData.EvadeUntil then
		return
	end

	local kind = string.lower(tostring(attackKind or ""))
	if string.find(kind, "punch", 1, true) then
		local center = getBossHeadPosition(model, hitbox)
		local direction = Vector3.new(attackCFrame.LookVector.X, 0, attackCFrame.LookVector.Z)
		if direction.Magnitude < 1 then direction = Vector3.new(hitbox.CFrame.LookVector.X, 0, hitbox.CFrame.LookVector.Z) end
		if direction.Magnitude < 1 then direction = Vector3.new(0, 0, 1) end
		local safePosition = center - direction.Unit * bossData.PunchBehindDistance
		root.CFrame = CFrame.lookAt(safePosition, center)
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		return "Punch"
	end

	if not string.find(kind, "stomp", 1, true) then return end
	if humanoid.Health / math.max(humanoid.MaxHealth, 1) <= bossData.StompHealthThreshold then
		bossData.DodgeStomps = true
	end
	if not bossData.DodgeStomps then return end

	local direction = Vector3.new(root.Position.X - attackCFrame.Position.X, 0, root.Position.Z - attackCFrame.Position.Z)
	if direction.Magnitude < 1 then direction = Vector3.new(-attackCFrame.LookVector.X, 0, -attackCFrame.LookVector.Z) end
	if direction.Magnitude < 1 then direction = Vector3.new(1, 0, 0) end
	direction = direction.Unit
	local safePosition = attackCFrame.Position + direction * bossData.EvadeDistance + Vector3.new(0, 18, 0)
	root.CFrame = CFrame.lookAt(safePosition, attackCFrame.Position)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	return "Stomp"
end

local function attackBoss(bossData, model, health, maxHealth, hitbox, bossLabel, healthLabel, bossLabelPrefix)
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then return end
	local evadeMode = evadeAttack(bossData, model, hitbox, root, humanoid)
	if evadeMode == "Stomp" then return end
	local punch = char:FindFirstChild("Punch") or (getBackpack() and getBackpack():FindFirstChild("Punch"))
	if punch and punch.Parent ~= char then humanoid:EquipTool(punch) end
	local leftHand = char:FindFirstChild("LeftHand")
	local rightHand = char:FindFirstChild("RightHand")
	local center = getBossHeadPosition(model, hitbox)
	if evadeMode ~= "Punch" then
		root.CFrame = CFrame.lookAt(center, center + hitbox.CFrame.LookVector)
	end
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	touch(hitbox, leftHand, 0)
	touch(hitbox, leftHand, 1)
	touch(hitbox, rightHand, 0)
	touch(hitbox, rightHand, 1)

	if os.clock() - bossData.LastPunch >= bossData.PunchInterval then
		bossData.LastPunch = os.clock()
		local me = getMuscleEvent()
		if me then
			pcall(function()
				me:FireServer("punch", "leftHand")
				me:FireServer("punch", "rightHand")
			end)
		end
		if punch then pcall(function() punch:Activate() end) end
	end

	if bossLabel then
		bossLabel.Text = (bossLabelPrefix or "Boss: ") .. tostring(model.Name)
	end
	if healthLabel then
		local hp = tonumber(health) or 0
		local mx = tonumber(maxHealth) or 0
		healthLabel.Text = "Health: " .. formatNumber(hp) .. " / " .. formatNumber(mx)
	end
end


Boss.Halloween.findActiveBoss = function(selectedOnly)
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local closest, closestHitbox, closestDist = nil, nil, math.huge
	for _, candidate in ipairs(CollectionService:GetTagged("HalloweenBoss")) do
		if candidate:IsA("Model") and candidate:IsDescendantOf(workspace)
			and Boss.Halloween.getBossHealth(candidate) > 0
			and (not selectedOnly or Boss.Halloween.shouldFarmBoss(candidate)) then
			local hitbox = candidate:FindFirstChild("BossDamageHitbox", true)
				or candidate.PrimaryPart or candidate:FindFirstChild("HumanoidRootPart")
			if hitbox and hitbox:IsA("BasePart") then
				if selectedOnly and candidate == Boss.Halloween.Data.Target then
					return candidate, hitbox
				end
				local dist = root and (root.Position - hitbox.Position).Magnitude or 0
				if not closest or dist < closestDist then
					closest, closestHitbox, closestDist = candidate, hitbox, dist
				end
			end
		end
	end
	return closest, closestHitbox
end


Boss.AutoFarmSwitch = BossTab:AddSwitch("Auto Farm Boss", function(state)
	if state and Boss.Halloween and Boss.Halloween.Data.Running then
		Boss.Halloween.AutoFarmSwitch:Set(false)
	end
	Boss.Data.Running = state
	Boss.Data.Generation += 1
	local generation = Boss.Data.Generation
	if not state then
		Boss.Data.Preparation = nil
		Boss.Data.Phase = "Waiting"
		Boss.StatusLabel.Text = "Status: Disabled"
		resumeTraining()
		return
	end

	task.spawn(function(gen)
		local wasFighting = false
		while Boss.Data.Running and Boss.Data.Generation == gen do
			pcall(function()
				local model, hp, mx, hitbox = Boss.findActiveBoss()
				local selected = model and Boss.shouldFarmBoss(model)
				if model and not selected then
					if wasFighting or Boss.Data.Preparation then
						Boss.Data.Preparation = nil
						wasFighting = false
						resumeTraining()
					end
					Boss.Data.Phase = "Waiting"
					Boss.StatusLabel.Text = "Status: Skipping " .. (workspace:GetAttribute("BossDisplayName") or model.Name)
				elseif model then
					if wasFighting and needsRetraining(Boss.Data) then wasFighting = false end
					if not wasFighting then
						if not prepareForBoss(Boss.Data) then return end
						wasFighting = true
						Boss.Data.Phase = "Fighting"
						Boss.Data.AttackSequence = nil
						Boss.Data.EvadeUntil = 0
						Boss.Data.DodgeStomps = false
						pauseTraining()
					end
					if not Boss.Data.Running or Boss.Data.Generation ~= gen then return end
					if needsRetraining(Boss.Data) then return end
					local hum = getLocalHumanoid()
					if hum and hum.Health > 0 then
						Boss.StatusLabel.Text = "Status: Fighting"
						attackBoss(Boss.Data, model, hp, mx, hitbox, Boss.BossLabel, Boss.HealthLabel, "Boss: ")
					else
						Boss.StatusLabel.Text = "Status: Waiting for Respawn"
					end
				elseif wasFighting then
					wasFighting = false
					Boss.Data.Phase = "Collecting"
					pcall(collectChest, gen)
					if not Boss.Data.Running or Boss.Data.Generation ~= gen then return end
					Boss.BossLabel.Text = "Boss: None"
					Boss.HealthLabel.Text = "Health: 0 / 0"
					if Boss.Data.ContinueTraining then resumeTraining() end
					Boss.Data.Phase = "Waiting"
					Boss.StatusLabel.Text = "Status: Waiting for Boss"
				else
					if Boss.Data.Preparation then
						Boss.Data.Preparation = nil
						resumeTraining()
					end
					Boss.StatusLabel.Text = "Status: Waiting for Boss"
				end
			end)
			task.wait(model and selected and 0.03 or 0.25)
		end
	end, generation)
end)


--[[
    RemX Hub - UI Library
    Para Roblox Studio y tus propios juegos.
    Coloca este ModuleScript en ReplicatedStorage con el nombre "RemXLibrary".
    La imagen de Rem debe subirse a Roblox y su ID colocarse en Config.BackgroundImage.
]]

local RemX = {}

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local DEFAULTS = {
    Title = "RemX Hub",
    Subtitle = "Script Hub • v1.0",
    Size = UDim2.fromOffset(720, 480),
    Position = UDim2.new(0.5, -360, 0.5, -240),
    BackgroundImage = "", -- Ejemplo: "rbxassetid://1234567890"
    BackgroundTransparency = 0.35,
    Accent = Color3.fromRGB(0, 145, 255),
    TextColor = Color3.fromRGB(245, 249, 255),
    PanelColor = Color3.fromRGB(5, 10, 24),
}

local function make(className, props, parent)
    local object = Instance.new(className)
    for key, value in pairs(props or {}) do
        object[key] = value
    end
    object.Parent = parent
    return object
end

local function round(parent, radius)
    make("UICorner", { CornerRadius = UDim.new(0, radius or 12) }, parent)
end

local function stroke(parent, color, thickness, transparency)
    make("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
    }, parent)
end

local function addPadding(parent, amount)
    make("UIPadding", {
        PaddingTop = UDim.new(0, amount),
        PaddingBottom = UDim.new(0, amount),
        PaddingLeft = UDim.new(0, amount),
        PaddingRight = UDim.new(0, amount),
    }, parent)
end

local function label(parent, text, size, position, fontSize, bold)
    return make("TextLabel", {
        BackgroundTransparency = 1,
        Text = text or "",
        Size = size,
        Position = position or UDim2.new(),
        Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextSize = fontSize or 14,
        TextColor3 = DEFAULTS.TextColor,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true,
    }, parent)
end

local function button(parent, text, size, color)
    local b = make("TextButton", {
        AutoButtonColor = true,
        Text = text,
        Size = size,
        BackgroundColor3 = color or Color3.fromRGB(8, 17, 38),
        TextColor3 = DEFAULTS.TextColor,
        Font = Enum.Font.GothamSemibold,
        TextSize = 14,
        BorderSizePixel = 0,
    }, parent)
    round(b, 10)
    stroke(b, DEFAULTS.Accent, 1, 0.15)
    return b
end

local function makeDraggable(frame, dragHandle)
    local dragging = false
    local dragStart, startPosition
    local activeInput

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = frame.Position
            activeInput = input
        end
    end)

    dragHandle.InputEnded:Connect(function(input)
        if input == activeInput
            or input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            activeInput = nil
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(
                startPosition.X.Scale, startPosition.X.Offset + delta.X,
                startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
            )
        end
    end)
end

function RemX:CreateWindow(config)
    config = config or {}
    local player = Players.LocalPlayer
    assert(player, "RemX Hub debe iniciarse desde un LocalScript.")

    local playerGui = player:WaitForChild("PlayerGui")
    local gui = make("ScreenGui", {
        Name = "RemXHubGui",
        ResetOnSpawn = false,
        IgnoreGuiInset = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, playerGui)

    local size = config.Size or DEFAULTS.Size
    local main = make("Frame", {
        Name = "MainWindow",
        Size = size,
        Position = config.Position or DEFAULTS.Position,
        BackgroundColor3 = config.PanelColor or DEFAULTS.PanelColor,
        BorderSizePixel = 0,
        ClipsDescendants = true, -- Mantiene el fondo de Rem dentro de la ventana.
    }, gui)
    round(main, 18)
    stroke(main, config.Accent or DEFAULTS.Accent, 2, 0)

    local backgroundImage = config.BackgroundImage or DEFAULTS.BackgroundImage
    if backgroundImage ~= "" then
        make("ImageLabel", {
            Name = "RemBackground",
            BackgroundTransparency = 1,
            Image = backgroundImage,
            ImageTransparency = config.BackgroundTransparency or DEFAULTS.BackgroundTransparency,
            ScaleType = Enum.ScaleType.Crop,
            Size = UDim2.fromScale(1, 1),
            Position = UDim2.fromScale(0, 0),
            ZIndex = 1,
        }, main)
    end

    local overlay = make("Frame", {
        Name = "TintOverlay",
        BackgroundColor3 = Color3.fromRGB(2, 8, 22),
        BackgroundTransparency = 0.28,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(1, 1),
        ZIndex = 2,
    }, main)

    local header = make("Frame", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, 64),
        BackgroundColor3 = Color3.fromRGB(2, 8, 22),
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
        ZIndex = 3,
    }, main)
    stroke(header, config.Accent or DEFAULTS.Accent, 1, 0.2)

    local title = label(header, config.Title or DEFAULTS.Title,
        UDim2.new(1, -145, 0, 31), UDim2.new(0, 16, 0, 5), 23, true)
    title.ZIndex = 4
    local subtitle = label(header, config.Subtitle or DEFAULTS.Subtitle,
        UDim2.new(1, -145, 0, 22), UDim2.new(0, 17, 0, 35), 12, true)
    subtitle.TextColor3 = config.Accent or DEFAULTS.Accent
    subtitle.ZIndex = 4

    local minimize = button(header, "−", UDim2.fromOffset(34, 34))
    minimize.Position = UDim2.new(1, -80, 0, 14)
    minimize.ZIndex = 5
    local close = button(header, "×", UDim2.fromOffset(34, 34))
    close.Position = UDim2.new(1, -40, 0, 14)
    close.ZIndex = 5

    local body = make("Frame", {
        Name = "Body",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 10, 0, 74),
        Size = UDim2.new(1, -20, 1, -84),
        ZIndex = 3,
    }, main)

    local sidebar = make("Frame", {
        Name = "Sidebar",
        BackgroundColor3 = Color3.fromRGB(3, 9, 24),
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 155, 1, 0),
        ZIndex = 3,
    }, body)
    round(sidebar, 12)
    stroke(sidebar, config.Accent or DEFAULTS.Accent, 1, 0.25)
    addPadding(sidebar, 8)

    local tabButtons = make("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = 4,
    }, sidebar)
    make("UIListLayout", {
        Padding = UDim.new(0, 7),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, tabButtons)

    local pageHost = make("Frame", {
        Name = "PageHost",
        BackgroundColor3 = Color3.fromRGB(3, 9, 24),
        BackgroundTransparency = 0.18,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 165, 0, 0),
        Size = UDim2.new(1, -165, 1, 0),
        ZIndex = 3,
    }, body)
    round(pageHost, 12)
    stroke(pageHost, config.Accent or DEFAULTS.Accent, 1, 0.25)

    local window = {
        Gui = gui,
        Frame = main,
        Pages = {},
        CurrentPage = nil,
        Config = config,
    }

    local function showPage(page)
        for _, item in pairs(window.Pages) do
            item.Frame.Visible = item == page
            item.Button.BackgroundColor3 = item == page
                and (config.Accent or DEFAULTS.Accent)
                or Color3.fromRGB(8, 17, 38)
        end
        window.CurrentPage = page
    end

    function window:CreateTab(tabName)
        local tabButton = button(tabButtons, tabName, UDim2.new(1, 0, 0, 42))
        tabButton.TextXAlignment = Enum.TextXAlignment.Left
        tabButton.Text = "   " .. tabName
        tabButton.LayoutOrder = #self.Pages + 1

        local page = make("ScrollingFrame", {
            Name = tabName .. "Page",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 8, 0, 8),
            Size = UDim2.new(1, -16, 1, -16),
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 4,
            ScrollBarImageColor3 = config.Accent or DEFAULTS.Accent,
            Visible = false,
            ZIndex = 4,
        }, pageHost)
        addPadding(page, 4)
        make("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, page)

        local pageData = { Name = tabName, Button = tabButton, Frame = page }
        table.insert(self.Pages, pageData)
        tabButton.MouseButton1Click:Connect(function()
            showPage(pageData)
        end)
        if #self.Pages == 1 then
            showPage(pageData)
        end

        local tab = {}

        function tab:CreateLabel(text)
            local item = label(page, text, UDim2.new(1, -4, 0, 30), nil, 14, true)
            item.LayoutOrder = #page:GetChildren()
            return item
        end

        function tab:CreateButton(options)
            options = options or {}
            local b = button(page, options.Name or "Button",
                UDim2.new(1, -4, 0, options.Height or 40))
            b.LayoutOrder = #page:GetChildren()
            b.MouseButton1Click:Connect(function()
                if options.Callback then
                    task.spawn(options.Callback)
                end
            end)
            return b
        end

        function tab:CreateToggle(options)
            options = options or {}
            local row = make("Frame", {
                BackgroundColor3 = Color3.fromRGB(4, 12, 29),
                BackgroundTransparency = 0.1,
                BorderSizePixel = 0,
                Size = UDim2.new(1, -4, 0, 44),
            }, page)
            row.LayoutOrder = #page:GetChildren()
            round(row, 10)
            stroke(row, config.Accent or DEFAULTS.Accent, 1, 0.45)

            local textLabel = label(row, options.Name or "Toggle",
                UDim2.new(1, -70, 1, 0), UDim2.new(0, 12, 0, 0), 14, false)
            local toggleButton = button(row, "", UDim2.fromOffset(42, 24),
                Color3.fromRGB(58, 68, 88))
            toggleButton.Position = UDim2.new(1, -52, 0.5, -12)
            local knob = make("Frame", {
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                Size = UDim2.fromOffset(18, 18),
                Position = UDim2.fromOffset(3, 3),
            }, toggleButton)
            round(knob, 9)

            local enabled = options.Default == true
            local function refresh()
                toggleButton.BackgroundColor3 = enabled
                    and (config.Accent or DEFAULTS.Accent)
                    or Color3.fromRGB(58, 68, 88)
                knob.Position = enabled and UDim2.new(1, -21, 0, 3)
                    or UDim2.fromOffset(3, 3)
            end
            refresh()

            toggleButton.MouseButton1Click:Connect(function()
                enabled = not enabled
                refresh()
                if options.Callback then
                    task.spawn(options.Callback, enabled)
                end
            end)

            return {
                Set = function(_, value)
                    enabled = value == true
                    refresh()
                    if options.Callback then
                        task.spawn(options.Callback, enabled)
                    end
                end,
                Get = function()
                    return enabled
                end,
            }
        end

        function tab:CreateSlider(options)
            options = options or {}
            local min = options.Min or 0
            local max = options.Max or 100
            local value = math.clamp(options.Default or min, min, max)

            local holder = make("Frame", {
                BackgroundColor3 = Color3.fromRGB(4, 12, 29),
                BackgroundTransparency = 0.1,
                BorderSizePixel = 0,
                Size = UDim2.new(1, -4, 0, 66),
            }, page)
            holder.LayoutOrder = #page:GetChildren()
            round(holder, 10)
            stroke(holder, config.Accent or DEFAULTS.Accent, 1, 0.45)

            label(holder, options.Name or "Slider",
                UDim2.new(1, -20, 0, 26), UDim2.new(0, 10, 0, 2), 13, true)

            local bar = make("Frame", {
                BackgroundColor3 = Color3.fromRGB(42, 55, 82),
                BorderSizePixel = 0,
                Position = UDim2.new(0, 10, 0, 39),
                Size = UDim2.new(1, -20, 0, 12),
            }, holder)
            round(bar, 6)

            local fill = make("Frame", {
                BackgroundColor3 = config.Accent or DEFAULTS.Accent,
                BorderSizePixel = 0,
                Size = UDim2.new((value - min) / math.max(max - min, 1), 0, 1, 0),
            }, bar)
            round(fill, 6)

            local hitbox = make("TextButton", {
                BackgroundTransparency = 1,
                Text = "",
                Size = UDim2.new(1, 0, 1, 0),
                ZIndex = 5,
            }, bar)

            local function setFromX(x)
                local fraction = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                value = math.floor(min + (max - min) * fraction + 0.5)
                fill.Size = UDim2.new(fraction, 0, 1, 0)
                if options.Callback then
                    task.spawn(options.Callback, value)
                end
            end

            hitbox.Activated:Connect(function()
                -- Activated supports mouse and touch taps.
                local mousePos = UserInputService:GetMouseLocation()
                setFromX(mousePos.X)
            end)

            local dragging = false
            hitbox.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    setFromX(input.Position.X)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch) then
                    setFromX(input.Position.X)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            return {
                Get = function()
                    return value
                end,
                Set = function(_, newValue)
                    value = math.clamp(newValue, min, max)
                    local fraction = (value - min) / math.max(max - min, 1)
                    fill.Size = UDim2.new(fraction, 0, 1, 0)
                    if options.Callback then
                        task.spawn(options.Callback, value)
                    end
                end,
            }
        end

        function tab:CreateDropdown(options)
            options = options or {}
            local choices = options.Options or {}
            local selected = options.Default or choices[1] or "Seleccionar"
            local drop = button(page, tostring(selected) .. "  ▼",
                UDim2.new(1, -4, 0, 40))
            drop.LayoutOrder = #page:GetChildren()
            local open = false
            local listFrame

            drop.MouseButton1Click:Connect(function()
                open = not open
                if listFrame then listFrame:Destroy() listFrame = nil end
                if not open then return end

                listFrame = make("Frame", {
                    BackgroundColor3 = Color3.fromRGB(3, 9, 24),
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, -4, 0, math.min(#choices * 34, 170)),
                }, page)
                round(listFrame, 8)
                stroke(listFrame, config.Accent or DEFAULTS.Accent, 1, 0.2)
                listFrame.LayoutOrder = #page:GetChildren()
                make("UIListLayout", { Padding = UDim.new(0, 3) }, listFrame)
                for _, choice in ipairs(choices) do
                    local optionButton = button(listFrame, tostring(choice),
                        UDim2.new(1, 0, 0, 32))
                    optionButton.MouseButton1Click:Connect(function()
                        selected = choice
                        drop.Text = tostring(selected) .. "  ▼"
                        open = false
                        if listFrame then listFrame:Destroy() listFrame = nil end
                        if options.Callback then
                            task.spawn(options.Callback, selected)
                        end
                    end)
                end
            end)

            return {
                Get = function()
                    return selected
                end,
                Set = function(_, value)
                    selected = value
                    drop.Text = tostring(selected) .. "  ▼"
                end,
            }
        end

        return tab
    end

    local minimized = false
    local bodySize = body.Size
    minimize.MouseButton1Click:Connect(function()
        minimized = not minimized
        body.Visible = not minimized
        main.Size = minimized and UDim2.new(size.X.Scale, size.X.Offset, 0, 64) or size
        minimize.Text = minimized and "+" or "−"
    end)
    close.MouseButton1Click:Connect(function()
        gui:Destroy()
    end)

    makeDraggable(main, header)

    function window:Destroy()
        gui:Destroy()
    end

    return window
end

return RemX
